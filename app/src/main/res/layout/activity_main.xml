<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A">

    <LinearLayout
        android:id="@+id/left_panel"
        android:layout_width="420dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#1A1A1A"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bardi &amp; Han River Tuya CCTV Launcher"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/help"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RTSP direct view • Tuya ONVIF device discovery • Android TV"
            android:textSize="9sp"
            android:textColor="#D0D0D0"
            android:alpha="0.8"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/btn_discover"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Scan Tuya"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btn_pip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="PIP"
                android:textSize="10sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/name_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nama / RTSP URL"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:textColorHint="#9AA0A6"
            android:layout_marginTop="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <EditText
                android:id="@+id/ip_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="192.168.1.64"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:textColorHint="#9AA0A6" />

            <EditText
                android:id="@+id/user_input"
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:hint="admin"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:textColorHint="#9AA0A6"
                android:layout_marginStart="4dp" />

            <EditText
                android:id="@+id/pass_input"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:hint="123456"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:textColorHint="#9AA0A6"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btn_add_bardi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Bardi"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_add_hanriver"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Han River"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_add_custom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Custom"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_stop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Stop Video"
            android:textSize="10sp"
            android:layout_marginTop="8dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:id="@+id/camera_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_toEndOf="@id/left_panel"
        android:background="#000000">

        <VideoView
            android:id="@+id/video_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Android TV CCTV • Live preview"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:padding="10dp"
            android:background="#66000000"
            android:layout_alignParentBottom="true"
            android:layout_margin="12dp" />
    </RelativeLayout>
</RelativeLayout>